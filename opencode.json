{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".opencode/instructions.md"
  ],
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "skill": "allow",
    "edit": "ask",
    "bash": {
      "git status": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git add*": "ask",
      "git commit*": "ask",
      "ls*": "allow",
      "cat*": "allow",
      "rm -rf*": "deny",
      "rm -r*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git reset --hard*": "deny",
      "sudo*": "deny",
      "chmod*": "deny",
      "curl*|*sh": "deny",
      "wget*|*sh": "deny"
    }
  }
}
